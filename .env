APP_NAME="MRH License Server"
APP_ENV=local
APP_KEY=base64:bZqSIEWLVu2hJrguewldT0/wwegC14rXVqK2OkLyt0c=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL / XAMPP defaults) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=license_server
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis (optional — recommended for cache + nonce store in production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mrhlicense.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- License Server (Phase 4–5) ----
# RSA key paths default to storage/keys/*.pem (see config/license.php), so you
# normally do NOT need to set the two path lines below — leave them commented.
# If your keys live elsewhere, uncomment and use an ABSOLUTE path with forward
# slashes, e.g. C:/laragon/www/license-server/storage/keys/private.pem
# (Do NOT use ${PWD} — it does not expand inside .env files.)
# LICENSE_RSA_PRIVATE_KEY=
# LICENSE_RSA_PUBLIC_KEY=
LICENSE_RSA_PASSPHRASE=
LICENSE_RSA_KEY_VERSION=v1
LICENSE_API_RATE_LIMIT=60
LICENSE_REPLAY_TTL=300

# ---- Initial admin login (used by AdminUserSeeder) ----
ADMIN_EMAIL=admin@konok.io
ADMIN_PASSWORD=@rsm@k@1A
